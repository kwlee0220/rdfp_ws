<?xml version="1.0"?>
<!--
  moveit_resources_panda_moveit_config 의 panda_hand.ros2_control.xacro 를
  포크하여 `gazebo` (ign_ros2_control) 하드웨어 분기를 추가한 버전이다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="panda_hand_ros2_control" params="name ros2_control_hardware_type">
        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${ros2_control_hardware_type == 'mock_components'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'isaac'}">
                    <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/isaac_joint_commands</param>
                    <param name="joint_states_topic">/isaac_joint_states</param>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'gazebo'}">
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </xacro:if>
            </hardware>
            <joint name="panda_finger_joint1">
                <command_interface name="position" />
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
            <!-- panda_finger_joint2 는 finger_joint1 을 mimic 한다. ign_ros2_control
                 (Fortress) 의 mimic 처리를 위해 command_interface 없이 state 만 둔다. -->
            <joint name="panda_finger_joint2">
                <param name="mimic">panda_finger_joint1</param>
                <param name="multiplier">1</param>
                <xacro:unless value="${ros2_control_hardware_type == 'gazebo'}">
                    <command_interface name="position" />
                </xacro:unless>
                <state_interface name="position">
                  <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </state_interface>
            </joint>
        </ros2_control>
    </xacro:macro>

</robot>
