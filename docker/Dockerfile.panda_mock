# panda mock 풀 앱 스택 이미지.
#
# run_panda_mock.sh 와 동일하게 rdfp_panda_mock.launch.py 를 실행한다.
# (ros2_control mock + MoveIt + RViz + camera + ee_pose + gripper +
#  session_control + image_viewer + image_recorder + target_joint_states)
#
#   docker build -f docker/Dockerfile.panda_mock -t rdfp-panda-mock:latest .
# (rdfp-base:latest 가 먼저 빌드되어 있어야 한다 — docker/build.sh 참고)
#
# 카메라 노드(OpenCV 웹캠)와 image_recorder(MP4)를 포함하므로, 실행 시
# /dev/video* 패스스루와 녹화 출력 볼륨이 필요하다(run_panda_mock.sh 참고).
# 웹캠이 없으면 enable_camera_node:=false 로 실행한다.
FROM rdfp-base:latest

# ENTRYPOINT 는 base 에서 상속(entrypoint.sh). CMD 만 교체한다.
CMD ["ros2", "launch", "rdfp", "rdfp_panda_mock.launch.py"]
