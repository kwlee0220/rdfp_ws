# Gazebo (Fortress) 백엔드 이미지.
#
# base 위에 ros_gz + ign_ros2_control(+ ign CLI)만 추가한다. mock/replay 이미지에는
# 영향이 없다(공유 베이스 패턴). panda_gazebo.launch.py(제어 스택)를 실행한다.
#
#   docker build -f docker/Dockerfile.gazebo -t rdfp-gazebo:latest .
# (rdfp-base:latest 가 먼저 빌드되어 있어야 한다 — docker/build.sh 참고)
#
# 필요한 이그니션 Fortress 런타임(libignition-gazebo6 등)은 ros-gz 의존성으로
# packages.ros.org 에서 자동 설치된다(OSRF 저장소 불필요).
FROM rdfp-base:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-ros-gz-sim \
      ros-humble-ros-gz-bridge \
      ros-humble-ros-gz-image \
      ros-humble-ign-ros2-control \
      ignition-tools \
    && rm -rf /var/lib/apt/lists/*

# ENTRYPOINT 는 base 에서 상속. CMD 만 교체한다.
#
# **제어 스택만 띄운다** — 묶음 launch `rdfp_panda_gazebo` 는 2026-09-13 에 삭제했다.
# 수집 계층이 필요하면 같은 `ROS_DOMAIN_ID` 로 `rdfp_collect` 를 따로 띄운다
# (호스트에서든 두 번째 컨테이너에서든). 컨테이너 하나에 launch 둘을 담을 수 없다.
CMD ["ros2", "launch", "robot_control", "panda_gazebo.launch.py"]
