# panda JGPC mock 풀 앱 스택 이미지.
#
# run_panda_jgpc_mock.sh 와 동일하게 rdfp_panda_jgpc_mock.launch.py 를 실행한다.
# (ros2_control mock + MoveIt + RViz + servo + camera + ee_pose + gripper +
#  session_control + image_viewer + image_recorder)
#
#   docker build -f docker/Dockerfile.panda_jgpc_mock -t rdfp-panda-jgpc-mock:latest .
# (rdfp-base:latest 가 먼저 빌드되어 있어야 한다 — docker/build.sh 참고)
#
# panda_mock 과의 차이: panda_arm_controller 의 타입만
# position_controllers/JointGroupPositionController 로 바뀐다(이름은 동일).
# 결과적으로 /panda_arm_controller/joint_trajectory 대신
# /panda_arm_controller/commands (std_msgs/Float64MultiArray) 를 받으며,
# FollowJointTrajectory 액션이 없으므로 move_group 의 arm plan & execute 는
# 동작하지 않는다. 계획은 정상이므로 create_move_group_client() 가 돌려주는
# MoveGroupJgpcClient 의 move_to_named_target() 를 사용한다.
#
# rdfp_panda_mock 과 달리 target_joint_states_publisher 는 포함되지 않는다
# (JGPC 스택에 JointTrajectory 발행자가 없다). 따라서 /target_joint_states 가
# 발행되지 않는다.
#
# 카메라 노드(OpenCV 웹캠)와 image_recorder(MP4)를 포함하므로, 실행 시
# /dev/video* 패스스루와 녹화 출력 볼륨이 필요하다(run_panda_jgpc_mock.sh 참고).
# 웹캠이 없으면 enable_camera_node:=false 로 실행한다.
FROM rdfp-base:latest

# ENTRYPOINT 는 base 에서 상속(entrypoint.sh). CMD 만 교체한다.
CMD ["ros2", "launch", "rdfp", "rdfp_panda_jgpc_mock.launch.py"]
